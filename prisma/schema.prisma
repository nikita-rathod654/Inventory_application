
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


model Product {
  id String @id @default(cuid())
  userId String // Stack Auth User ID
  name String
  sku String? @unique
  price Decimal @db.Decimal(12,2)
  quantity Int @default(0)
  lowStockAt Int?

  movements StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, name])
  @@index([createdAt])
}

enum MovementReason {
  INITIAL
  RESTOCK
  RETURN
  SALE
  DAMAGED
  CORRECTION
}

model StockMovement {
  id            String         @id @default(cuid())
  productId     String
  userId        String // who made the change (Stack Auth user ID)
  change        Int // +10 or -3
  quantityAfter Int // the balance right after this change
  reason        MovementReason
  note          String?
  createdAt     DateTime       @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([userId])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model Supplier {
  id     String  @id @default(cuid())
  userId String // Stack Auth User ID
  name   String
  email  String?
  phone  String?
  notes  String?

  orders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, name])
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  number     Int                 @unique @default(autoincrement()) // shown as PO-0001
  userId     String
  supplierId String
  status     PurchaseOrderStatus @default(DRAFT)
  notes      String?
  expectedAt DateTime?
  orderedAt  DateTime?
  receivedAt DateTime?
  cancelledAt DateTime?

  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items    PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, createdAt])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitCost        Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, productId])
  @@index([productId])
}